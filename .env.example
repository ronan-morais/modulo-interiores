# Domínio público usado em canonical, sitemap, robots e Open Graph.
NEXT_PUBLIC_SITE_URL=https://modulointeriores.com.br

# Banco Turso (libSQL) onde o formulário de orçamento grava os pedidos.
# Em desenvolvimento, use file:./.data/orcamentos.db e deixe o token vazio.
TURSO_DATABASE_URL=libsql://seu-banco.turso.io
TURSO_AUTH_TOKEN=

# CRM (/crm)
ADMIN_USER=
ADMIN_PASSWORD=
CRM_SESSION_SECRET=

# Token de leitura dos leads (GET /api/leads). Usado pela automação que gera
# a lista de material e envia por e-mail. Deixe vazio para desligar o endpoint.
LEADS_API_TOKEN=

# Atendimento automático do Direct (@modulointeriores)
# Webhook: https://modulointeriores.com.br/api/instagram/webhook
# IG_ACCESS_TOKEN: token de longa duração da conta do Instagram (graph.facebook.com)
# IG_USER_ID: id do usuário do Instagram profissional (17841480893320913)
# IG_VERIFY_TOKEN: string combinada com a Meta na verificação do webhook
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_VERIFY_TOKEN=
