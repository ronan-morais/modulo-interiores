# Domínio público usado em canonical, sitemap, robots e Open Graph.
NEXT_PUBLIC_SITE_URL=https://modulointeriores.com.br

# Banco Turso (libSQL) onde o formulário de orçamento grava os pedidos.
# Em desenvolvimento, use file:./.data/orcamentos.db e deixe o token vazio.
TURSO_DATABASE_URL=libsql://seu-banco.turso.io
TURSO_AUTH_TOKEN=

# CRM (/crm)
ADMIN_USER=
ADMIN_PASSWORD=
CRM_SESSION_SECRET=

# Token de leitura dos leads (GET /api/leads). Usado pela automação que gera
# a lista de material e envia por e-mail. Deixe vazio para desligar o endpoint.
LEADS_API_TOKEN=
